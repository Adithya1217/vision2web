MSME_ENVIRONMENT=development
MSME_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/msme
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MSME_JWT_SECRET=change-me-in-production
MSME_ACCESS_TOKEN_MINUTES=720
MSME_CORS_ORIGINS=["http://localhost:3000"]
# Optional: enables the Claude-backed intent parser (the rule parser is used otherwise)
# MSME_ANTHROPIC_API_KEY=
# MSME_ANTHROPIC_MODEL=claude-opus-5
